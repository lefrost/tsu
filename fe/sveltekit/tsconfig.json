{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"$all": ["../../all"],
			"$all/*": ["../../all/*"],
			"$edge": ["./edge"],
			"$edge/*": ["./edge/*"],
			"$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"],
			"$paraglide": ["../../all/fe/paraglide"],
			"$paraglide/*": ["../../all/fe/paraglide/*"]
		},
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"moduleResolution": "bundler"
	}
}
