{
  "name": "@tsu/all",
  "version": "0.0.1",
  "private": true,
  "exports": {
    "./betterauth": "./betterauth/index.ts",
    "./betterauth/schema": "./betterauth/schema.ts",
    "./drizzle": "./drizzle/index.ts",
    "./drizzle/schema": "./drizzle/schema.ts",
    "./paraglide/*": "./paraglide/generated/*"
  },
  "typesVersions": {
    "*": {
      "betterauth": [
        "./betterauth/index.ts"
      ],
      "betterauth/schema": [
        "./betterauth/schema.ts"
      ],
      "drizzle": [
        "./drizzle/index.ts"
      ],
      "drizzle/schema": [
        "./drizzle/schema.ts"
      ],
      "paraglide/*": [
        "./paraglide/generated/*"
      ]
    }
  },
  "scripts": {
    "db:reset": "bun run ./drizzle/reset.ts",
    "db:push": "bunx drizzle-kit --config=./drizzle/drizzle.config.ts push --force",
    "db:generate": "bunx drizzle-kit --config=./drizzle/drizzle.config.ts generate",
    "db:migrate": "bunx drizzle-kit --config=./drizzle/drizzle.config.ts migrate",
    "db:studio": "bunx drizzle-kit --config=./drizzle/drizzle.config.ts studio",
    "auth:schema": "better-auth generate --config ./betterauth/index.ts --output ./betterauth/schema.ts --yes"
  },
  "dependencies": {
    "@better-auth/cli": "^1.4.21",
    "@better-auth/i18n": "^1.6.25",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.6.23",
    "better-call": "^2.0.5",
    "bunqueue": "^2.8.59",
    "drizzle-orm": "^0.45.2",
    "nodemailer": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.22.0",
    "@types/nodemailer": "^8.0.1",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}