{
  "compilerOptions": {
    "target": "ES2021",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["bun-types"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "paths": {
      "$all": ["./"],
      "$all/*": ["./*"],
			"$paraglide": ["./paraglide"],
			"$paraglide/*": ["./paraglide/*"]
		},
  }
}
